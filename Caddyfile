:{$PORT:80} {
    root * /app/public
    encode zstd gzip

    header {
        X-Content-Type-Options "nosniff"
        Referrer-Policy "same-origin"
        X-Frame-Options "SAMEORIGIN"
        -Server
    }

    # File konfigurasi dan helper PHP hanya boleh di-include oleh PHP,
    # bukan dipanggil langsung melalui URL.
    @privateFiles path /auth.php /config.php /pengaturan_ttd.php /redis_session.php /storage/* /.htaccess /.env /.env.* /reference/* /Code.gs
    respond @privateFiles "Not Found" 404

    php_server
}
