# Local Docker uses APP_ENV=local. On Vercel set APP_ENV=production.
APP_ENV=local
TZ=Asia/Jakarta

# Google Apps Script
GAS_URL=https://script.google.com/macros/s/AKfycbx5Uqbz1PNu-2KkTP7YgCWD7hq-8-ks3z0Bn9QfzL0Xt49t9c4UWibYJ6NXQCRGLPyJ/exec
GAS_API_KEY=PASTE_THE_EXISTING_PHP_RAPOR_API_KEY_HERE

# Upstash Redis REST credentials (Vercel Marketplace integration)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Private Vercel Blob read/write token
BLOB_READ_WRITE_TOKEN=
